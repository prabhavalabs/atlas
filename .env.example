# Copy to .env for local Compose or /opt/atlas/.env on the VPS.
# Keep the resulting file mode 0600 and never commit real values.
ATLAS_IMAGE=ghcr.io/prabhavalabs/atlas:latest
ATLAS_DB_PASSWORD=replace-with-a-long-url-safe-random-value
ATLAS_DATABASE_URL=postgres://atlas:replace-with-the-same-url-safe-value@db:5432/atlas?sslmode=disable
ATLAS_METRICS_TOKEN=replace-with-a-random-operator-token
ATLAS_RUNTIME_UID=1000
ATLAS_RUNTIME_GID=1000
ATLAS_PUBLIC_URL=https://atlas.prabhavalabs.com
ATLAS_API_URL=https://atlas-api.prabhavalabs.com
ATLAS_CORS_ORIGINS=https://atlas.prabhavalabs.com
ATLAS_CSRF_COOKIE_DOMAIN=prabhavalabs.com
